! ============================================================================
! yelmox (climate = esm) main config -- 1pctCO2 Greenland.
! As yelmox_esm_Greenland.nml except &esm and &transient: the 1pctCO2 forcing
! (input/esm/esm_grl_1pctCO2.nml; global CMIP fields of [esm] esm_name, remapped
! online). Run via scripts/1pctCO2/run_1pctco2_greenland.sh.
! ============================================================================
&ctrl
    run_step        = "spinup"
    calendar        = True              ! timeline in calendar years (tstep_const = calendar time)
    calendar_ref    = 2000.0            ! [yr CE] calendar reference
    restart         = "None"            ! restart bundle folder to start from, or "None" for a cold start
/

&esm
    ! Experiment  (1pctCO2: absolute CMIP fields, self-referenced -- see input/esm/esm_grl_1pctCO2.nml)
    par_file        = "input/esm/esm_grl_1pctCO2.nml"
    experiment      = "1pctCO2"         ! spinup uses ctrl; the scenario step sets 1pctCO2
    use_esm         = False             ! use ESM snapshots? (scenario step sets True)
    esm_name        = "MPI-ESM1-2-LR"   ! {gcm} of the 1pctCO2 forcing files (see the par_file header)

    ! Forcing switches (the smb source is [comps] surface_method)
    use_var         = False             ! include climate variability
    use_hist        = False             ! load historical period
    use_proj        = False             ! load projection period

    ! Climatic variables
    lapse           = 8.0e-3 6.5e-3     ! lapse rate (sum, ann)
    f_p             = 0.05              ! Claus-Cl. term
    f_ocn           = 0.5               ! Oceanic warm fraction. Only used for homogeneous.
    f_polar         = 1.8               ! Polar amplification
    dT_threshold    = 0.0               ! Only the homogeneous use_esm=False analytic path uses this;
                                        ! UNUSED on the gridded use_esm=True path.

/

&spinup
    tstep_method    = "const"           ! "const" (time=time_elapsed) or "cal" (time=time_cal)
    tstep_const     = 2015              ! Assumed time for "const" method
    time_init       = 0.0               ! [yr] Starting time (model years)
    time_end        = 15e3              ! [yr] Ending time (model years; = opt cf/tf_time_end)
    dtt             = 1.0               ! [yr] Main loop timestep

    ! Time intervals (check with ESM forcings)
    time_ref        = 1961, 1990        ! [yr] Year interval used as Reference
                                        ! If "opt" this time interval will be used as optimization
    time_esm_ref    = 1960, 1989        ! [yr] Year interval used as Reference of ESM
    time_hist       = 1850, 2014        ! [yr] Year interval used as Historical period
    time_proj       = 2015, 2300        ! [yr] Year interval used as Projection period

    clim_var        = False             ! include climate variability
    clim_seed       = 10                ! Randomnes seed
/

&transient
    ! 1pctCO2 runs on the CMIP calendar clock: years 2020..2160 (140 yr), forcing =
    ! absolute CMIP fields self-referenced to the run start (~1xCO2). See the
    ! esm_grl_1pctCO2.nml header for the referencing scheme.
    tstep_method    = "cal"             ! "const" (time=time_elapsed) or "cal" (time=time_cal)
    tstep_const     = 2020              ! Assumed time for "const" method
    time_init       = 2020.0            ! [yr] 1pctCO2 start (year 2020 = 1xCO2)
    time_end        = 2160.0            ! [yr] 1pctCO2 end (140 yr; ~4xCO2 near yr 140)
    dtt             = 1.0               ! [yr] Main loop timestep

    ! Time intervals (check with ESM forcings)
    time_ref        = 1961, 1990        ! [yr] Reference period for the MAR base climatology
                                        ! If "opt" this time interval will be used as optimization
    time_esm_ref    = 2020, 2021        ! [yr] self-reference: 1pctCO2 start (~1xCO2 baseline),
                                        ! so dts = tas(t) - mean(tas over 2020-2021)
    time_hist       = 2018, 2019        ! [yr] no historical: kept BELOW time_init so the time-routed
                                        ! "time<=time_hist(2)" branch in esm_forcing_update never fires
                                        ! (ts_hist et al. are not even allocated when use_hist=False).
    time_proj       = 2020, 2160        ! [yr] 1pctCO2 projection window (full run)

    clim_var        = False             ! include climate variability
    clim_seed       = 1                 ! Randomnes seed
/

&tsforcing
    active = False    ! Apply transient tsgen forcing? (yelmox; unused by the esm climate)
    f_ta   = 1.0      ! [K]   dTa = f_now * f_ta  (atmospheric temperature)
    f_to   = 0.0      ! [K]   dTo = f_now * f_to  (ocean temperature)
    f_so   = 0.0      ! [psu] dSo = f_now * f_so  (ocean salinity)
    restart_every_df = 0.0  ! [f] write a restart bundle each |Δf|; 0 = off
/

&tsgen
    method     = "const"    ! const|ramp-slope|ramp-time|ramp-time-step|sin|exp|PI42|H312b|H312PID|H321PID|PID1
    with_kill  = False      ! stop the run once the response equilibrates at a bound
    dt_init    = 0.0        ! [yr]  hold forcing flat during this initial interval
    dt_ramp    = 300.0      ! [yr]  ramp/period length (ramp-time, ramp-time-step, sin)
    dt_conv    = -1.0       ! [yr]  convergence interval (ramp-time-step)
    dt_ave     = 100.0      ! [yr]  averaging window for the response derivative (feedback)
    df_sign    = 1          ! +1/-1 direction of forcing change
    tol        = 1.0        ! response-rate tolerance (feedback/kill)
    df_dt_max  = 0.001      ! [f/yr] maximum forcing rate
    sigma      = 0.0        ! [f]   std. dev. of optional gaussian noise
    f_min      = 0.0        ! [f]   lower forcing bound
    f_max      = 5.0        ! [f]   upper forcing bound
    f_conv     = 0.0        ! [f]   hold value after convergence (ramp-time-step)
/

&tm_1D
    method          = "const"           ! "const", "file", "times"
    dt              = 1.0
    file            = "input/timeout_ramp_100kyr.txt"
    times           = -10, -5, 0, 1, 2, 3, 4, 5, 10, 15, 20, 25, 30, 35, 40, 45, 50, 55
/

&tm_2D
    method          = "const"           ! "const", "file", "times"
    dt              = 15e3
    file            = "input/timeout_ramp_100kyr.txt"
    times           = 1020
/

&tm_2Dsm
    method          = "const"           ! "const", "file", "times"
    dt              = 100
    file            = "input/1pctCO2_out.txt"
    times           = 1020
/

&tm_rst
    method          = "const"           ! "none", "const", "file", "times" (+ always at time_end)
    dt              = 20e3
    file            = "input/timeout_ramp_100kyr.txt"
    times           = 0
/

&opt
    opt_cf           = "L21"             ! Basal friction optimization: "none", "L21"
    cf_time_init     = 0.0               ! [yr] When should optimization of basal friction start?
    cf_time_end      = 15e3              ! [yr] When should optimization of basal friction stop?
    cf_init          = 0.1               ! Initial value of cf_ref everywhere (negative uses cb_tgt) if not using restart file
    tau_c            = 500.0             ! [yr] L21: Optimization relaxation timescale
    H0               = 100.0             ! [m]  L21: Optimization ice-thickness error scaling

    sigma_err       = 50e3              ! [m] Smoothing radius for error to calculate correction in cf_ref
    sigma_vel       = 100.0             ! [m/yr] Speed at which smoothing diminishes to zero
    fill_method     = "cf_min"          ! nearest, analog, target, cf_min

    opt_tf          = "L21-points"      ! Thermal forcing optimization: "none", "L21" (by basin), "L21-points"
    tf_time_init    = 0.0               ! [yr] When should optimization of thermal forcing start?
    tf_time_end     = 15e3              ! [yr] When should optimization of thermal forcing stop?
    H_grnd_lim      = 500.0             ! [m] Distance from grounding line to consider in terms of thickness above flotation
    tf_sigma        = 50e3              ! [m] L21-points: Smoothing radius for error to calculate tf_corr
    tau_m           = 100.0              ! [yr] Optimization relxation timescale
    m_temp          = 10.0              ! [m yr^−1 degC^−1] Optimization scaling value
    tf_min          = -3.0              ! [degC] Minimum allowed tf_corr value
    tf_max          =  0.5              ! [degC] Maximum allowed tf_corr value
    tf_basins       = -1                ! L21: Basin numbers to optimize (-1 for all basins)
    basin_fill      = False             ! L21-points: If true, fill grounded basins with ice-shelf mean tf_corr values
/

&relax
    ! Relaxation of the topography ([sim] relax), over the time elapsed since the start of the run.
    topo_rel        = 4                 ! ytopo.topo_rel mode while active (4: grounding line + grounding zone)
    tau1            = 100               ! [yr] Relaxation timescale until time1
    tau2            = 2000.0            ! [yr] Relaxation timescale at time2
    time1           = 2e3               ! [yr] End of the tau1 period
    time2           = 6e3               ! [yr] End of the relaxation (then the ytopo values apply)
    m               = 2.0               ! [--] Non-linear exponent of the tau1 -> tau2 ramp
/

&yelmo
    ! domain, grid_name and the grid come from &domain
    phys_const      = "Earth"
    experiment      = "None"            ! "None", "EISMINT1", "MISMIP3D"  to apply special boundary conditions
    nml_ytopo       = "ytopo"
    nml_ycalv       = "ycalv"
    nml_ydyn        = "ydyn"
    nml_ytill       = "ytill"
    nml_yhyd        = "yhyd"
    nml_ymat        = "ymat"
    nml_ytherm      = "ytherm"
    nml_masks       = "yelmo_masks"
    nml_init_topo   = "yelmo_init_topo"
    nml_data        = "yelmo_data"
    restart         = "none"
    restart_z_bed   = True              ! Take z_bed (and z_bed_sd) from restart file
    restart_H_ice   = True              ! Take H_ice from restart file
    restart_relax   = 500               ! [yrs] Years to relax from restart=>input topography
    log_timestep    = False
    disable_kill    = False             ! Disable automatic kill if unstable
    zeta_scale      = "exp"             ! "linear", "exp", "tanh"
    zeta_exp        = 2.0
    nz_aa           = 10                ! Vertical resolution in ice
    dt_method       = 2                 ! 0: no internal timestep, 1: adaptive, cfl, 2: adaptive, pc
    dt_min          = 0.1               ! [a] Minimum timestep
    cfl_max         = 0.5               ! Maximum value is 1.0, lower will be more stable
    pc_method       = "AB-SAM"          ! "FE-SBE", "AB-SAM", "HEUN"
    pc_controller   = "PI42"            ! PI42, H312b, H312PID, H321PID, PID1
    pc_use_H_pred   = True              ! Use predicted H_ice instead of corrected H_ice
    pc_filter_vel   = True              ! Use mean vel. solution of current and previous timestep
    pc_n_redo       = 5                 ! How many times can the same iteration be repeated (when high error exists)
    pc_tol          = 1.0               ! [1/a] Redo the timestep when pc_eta > pc_tol; pc_eta = RMS of tau/(1 m + 0.01 H) over the pc mask without the pc_eta_trim largest, tau = pc truncation error [m/a]
    pc_eps          = 0.02               ! [1/a] Target pc_eta of the adaptive timestep (dt_method=2), must be <= pc_tol

/

&ytopo
    solver              = "impl-lis"        ! "expl", "impl-lis"
    grad_lim            = 0.07               ! [m/m] Maximum allowed sloped in gradient calculations (dz/dx,dH/dx)
    grad_lim_zb         = 0.05               ! [m/m] Maximum allowed sloped in bed gradient (dzb/dx)
    front_subgrid       = "marine"          ! Subgrid ice fronts: "none" (binary f_ice), "floating", "marine" (floating + marine-grounded)
    front_H_eff_min     = 50.0              ! [m] Minimum effective thickness of front cells (front_subgrid)
    front_dHdx          = 0.0               ! [m/m] Thickness gradient assumed at a full front (front_subgrid)
    use_bmb             = True              ! Use basal mass balance in mass conservation equation
    topo_fixed          = False             ! Keep ice thickness fixed, perform other ytopo calculations
    topo_rel            = 0                 ! 0: No relaxation; 1: relax shelf; 2: relax shelf + gl; 3: all points
    topo_rel_tau        = 10.0              ! [a] Time scale for relaxation
    topo_rel_field      = "H_ref"           ! "H_ref" or "H_ice_n"

    ! === Grounding line ===
    bmb_gl_method       = "pmp"             ! "fcmp": flotation; "fmp": full melt; "pmp": partial melt; "nmp": no melt
    gl_sep              = 1                 ! 1: binary f_grnd, linear f_grnd_acx/acy; 3: grounded area of H_grnd bilinear between cell centres (Leguy et al., 2021)
    gz_nx               = 15                ! [-] Subgrid points per side (gz_nx*gz_nx) of the grounding-zone melt, bmb_gl_method = "pmpt"

    ! bmb_gl_method = pmpt
    dist_grz            = 200.0             ! [km] Radius to consider part of "grounding-line zone" (grz)
    gz_Hg0              = 0.0               ! Grounding zone, limit of penetration of bmb_grnd
    gz_Hg1              = 100.0               ! Grounding zone, limit of penetration of bmb_shlf

    ! === discharge mass balance ===
    dmb_method          = 0                 ! 0: no subgrid discharge, 1: subgrid discharge on
    dmb_alpha_max       = 60.0              ! [deg] Maximum angle of slope from coast at which to allow discharge
    dmb_tau             = 100.0             ! [yr]  Discharge timescale
    dmb_sigma_ref       = 300.0             ! [m]   Reference bed roughness
    dmb_m_d             = 3.0               ! [-]   Discharge distance scaling exponent
    dmb_m_r             = 1.0               ! [-]   Discharge resolution scaling exponent

    ! === frontal mass melt ===
    fmb_method          = 0                 ! 0: prescribe boundary field fmb_shlf; 1: calculate proportional fmb~bmb_shlf.
    fmb_scale           = 1.0               ! Scaling of fmb ~ scale*bmb, scale=10 suggested by Pollard and DeConto (2016)
/

&ycalv
    ! === calving method & law ===
    use_lsf             = True              ! use level-set method
    lsf_method          = "snap"            ! "snap" (legacy neighbour-snap) or "redist" (Sussman/Osher)
    dt_lsf              = -1                ! [yr] lsf update timescale. If negative: no reset.
    lsf_redist_n_iter   = 5                 ! Sussman/Osher LSF redistancing iterations. redist mode only.
    calv_flt_method     = "zero"            ! "zero", "simple", "flux", "vm-l19", "kill"
    calv_grnd_method    = "zero"            ! "zero", "stress-b12"

    ! === numeric noise ===
    H_min_grnd          = 5.0               ! [m] Minimum ice thickness at grounded margin (thinner ice is ablated) - helps with stability, smaller value will lead to more precise summit
    H_min_flt           = 0.0               ! [m] Minimum ice thickness at floating margin (thinner ice is ablated) - helps with stability
    sd_min              = 100.0             ! [m] calv_grnd(z_bed_sd <= sd_min) = 0.0
    sd_max              = 500.0             ! [m] calv_grnd(z_bed_sd >= sd_max) = calv_max
    calv_grnd_max       = 0.0               ! [m/a] Maximum grounded calving rate from high stdev(z_bed)

    ! ===
    calv_tau            = 1.0               ! [a] Characteristic calving time
    calv_thin           = 30.0              ! [m/yr] Calving rate to apply to very thin ice
    k2                  = 3.2e9             ! [m yr] eigen calving scaling factor (Albrecht et al, 2021 recommend 1e17 m s == 3.2e9 m yr)
    w2                  = 25.0               ! Weighting coefficient of 2nd principal strain/stress
    kt_ref              = 0.00255            ! [m yr-1 Pa-1] vm-l19 calving scaling parameter
    kt_deep             = 0.1               ! [m yr-1 Pa-1] vm-l19 calving scaling parameter for deep ocean
    tau_ice_flt         = 100.0e3           ! [Pa] Ice strength failure, floating fronts (vm-m16)
    tau_ice_grnd        = 100.0e3           ! [Pa] Ice strength failure, marine-grounded fronts (vm-m16)

    ! === threshold method ===
    Hc_ref_flt          = 200.0             ! [m] Calving limit in ice thickness (thinner ice calves)
    Hc_ref_grnd         = 200.0             ! [m] Calving limit in grounded ice thickness (thinner ice calves)
    Hc_ref_thin         = 50.0              ! [m] Reference ice thickness for thin ice calving
    Hc_deep             = 500.0             ! [m] Calving limit in ice thickness (thinner ice calves)
    zb_deep_0           = -1000.0           ! [m] Bedrock elevation to begin transition to deep ocean
    zb_deep_1           = -1500.0           ! [m] Bedrock elevation to end transition to deep ocean
    zb_sigma            = 0.0               ! [m] Gaussian filtering of bedrock for calving transition to deep ocean
/

&ydyn
    solver              = "diva"          ! "fixed", "sia", "ssa", "hybrid", "diva", "diva-noslip", "l1l2", "l1l2-noslip"
    uz_method           = 3               ! 1: aa-staggering, 2: strain-rate-on-nodes, 3: jacobian
    visc_method         = 1               ! 0: constant visc=visc_const, 1: dynamic viscosity
    visc_const          = 1e7             ! [Pa a] Constant value for viscosity (if visc_method=0)
    beta_method         = 3               ! 0: constant beta; 1: linear (beta=cb/u0); 2: psuedo-plastic-power; 3: Regularized Coulomb
    beta_const          = 1e3             ! [Pa a m−1] Constant value of basal friction coefficient to be used
    beta_q              = 0.2             ! Dragging law exponent
    beta_u0             = 100.0           ! [m/a] Regularization term for regularized Coulomb law (beta_method=3)
    beta_gl_scale       = 0               !  0: beta*beta_gl_f, 1: H_grnd linear scaling, 2: Zstar scaling
    beta_gl_stag        = 3               !  0: simple staggering, 1: Upstream beta at gl, 2: downstream, 3: f_grnd_ac scaling
    beta_gl_f           = 1.0             ! [-] Scaling of beta at the grounding line (for beta_gl_scale=0)
    taud_gl_method      = 0               !  0: binary, no subgrid, 1: Two-sided gradient
    H_grnd_lim          = 500.0           ! [m] For beta_gl_scale=1, reduce beta linearly between H_grnd=0 and H_grnd_lim
    beta_min            = 100            ! [Pa a m-1] Minimum value of beta allowed for grounded ice (for stability)
    frz_scale           = True            ! Reduce sliding where the bed is below the pressure melting point: beta*f**(-q), f=frz_min+(1-frz_min)*exp(T_prime_b/frz_efold)
    eps_0               = 1e-6            ! [1/a] Regularization term for effective viscosity - minimum strain rate
    ssa_solver           = "energy"       ! "residual" | "energy"
    ssa_lis_opt_residual = "-i minres -p jacobi -maxiter 100 -tol 1.0e-2 -initx_zeros false"  ! See Lis library !-omp_num_threads 2
    ssa_lis_opt_energy   = "-i cg -p ssor -maxiter 200 -tol 1.0e-3 -initx_zeros false"         ! SPD => CG; tol 1e-3 is below the Picard tolerance ssa_iter_conv
    ssa_lat_bc          = "all"           ! "all", "marine", "floating", "none", "slab"
    ssa_vel_max         = 10000.0          ! [m a-1] Velocity limit: clip value (both methods); "drag": also the speed at which the limit drag reaches ssa_vel_lim_tau
    ssa_iter_max        = 5               ! Number of maximum allowed iterations over ssa to converge on vel. solution
    ssa_iter_rel        = 0.7             ! [--] Relaxation fraction [0:1] to stabilize ssa iterations
    ssa_iter_conv       = 1e-2            ! [--] L2 relative error convergence limit to exit ssa iterations
    taud_lim            = 1e5             ! [Pa] Maximum allowed driving stress
    neff_nxi            = 0               ! Subgrid interpolation of hyd%N onto dyn%N_eff. 0: none, 1: Gaussian quadrature, >1: nxi x nxi subgrid.

/

&ytill
    method          = -1               ! -1: set externally; 1: calculate cb_ref online
    scale_zb        = 0                 ! 0: none, 1: lin, 2: exp : scaling with elevation
    scale_sed       = 0                 ! 0: none, 1: min(cb_zb,cb_sed), 2: cb_zb*(lambda_sed*f_sed), 3: 2 but no lower limit
    is_angle        = False             ! cb_ref is a till strength angle?
    n_sd            = 10                ! Number of samples over z_bed_sd field
    f_sed           = 1.0               ! Scaling reduction for thick sediments
    sed_min         = 100.0               ! [m] Sediment thickness for no reduction in friction
    sed_max         = 200.0              ! [m] Sediment thickness for maximum reduction in friction
    z0              = -700.0            ! [m] Bedrock rel. to sea level, lower limit
    z1              =  700.0            ! [m] Bedrock rel. to sea level, upper limit
    cf_min          =  1             ! [-- or deg] Minimum value of cf
    cf_ref          =  40             ! [-- or deg] Reference/const/max value of cf
/

&yhyd
    ! Basal hydrology (fasthydrology). Closure parameters mirror the legacy
    ! &yneff till closure; W_til_max / bkt_till_rate mirror the legacy &ytherm bucket.
    method_til       = 1   ! 0=NONE 1=BUCKET
    method_transport = 0   ! 0=NONE 1=K24
    W_til_max        = 2.0 ! [m]   was ytherm.H_w_max
    mask_bc          = 0   ! 0=ZERO 1=IMPOSED 2=MIRROR
    W_til_bc         = 0.0 ! [m]

    ! ---- bucket (bkt_) ----
    bkt_N_closure     = 2    ! 0=CONST 1=OVERBURDEN 2=MARINE 3=TILL 4=TWO_VALUE
    bkt_till_rate     = 1e-3 ! [m/a]  was ytherm.till_rate
    bkt_floating_mode = 0    ! 0=ZERO 1=MARGIN_FILL (legacy saturate floating+margin ring)

    ! ---- closures (no prefix) ----
    const_N         = 1.0e7  ! [Pa] N_CLOSURE_CONST (legacy yneff.const)
    marine_p        = 1.0
    marine_rho_sw   = 1028.0
    till_N0         = 1000.0 ! legacy yneff.N0
    till_delta      = 0.8    ! legacy yneff.delta
    till_e0         = 0.69   ! legacy yneff.e0
    till_Cc         = 0.12   ! legacy yneff.Cc
    two_value_delta = 0.02

    ! ---- k24 (k24_) ----  unused under method_transport=0
    k24_substrate_type               = 0
    k24_flux_solver                  = 3
    k24_glen_n                       = 3.0
    k24_latent_heat_water            = 3.35e5
    k24_bed_bump_height              = 0.1
    k24_flux_W_exponent              = 1.25
    k24_flux_grad_exponent           = 1.5
    k24_friction_factor              = 0.1
    k24_till_factor                  = 1.1
    k24_critical_discharge           = 1.0
    k24_H0_efficient                 = 0.1
    k24_conduit_spacing              = 1.0e4
    k24_coupling_length_kamb86       = 10.0
    k24_min_pressure_fraction        = 0.02
    k24_water_viscosity              = 1.8e-3
    k24_W_min                        = 1.0e-8
    k24_W_max                        = 0.015
/

&ymat
    flow_law                = "glen"        ! Only "glen" is possible right now
    rf_method               = 1             ! -1: set externally; 0: rf_const everywhere; 1: standard function
    rf_const                = 1e-18         ! [Pa^-3 a^-1]
    rf_use_eismint2         = False         ! Only applied for rf_method=1
    rf_with_water           = False         ! Only applied for rf_method=1, scale rf by water content?
    n_glen                  = 3.0           ! Glen flow law exponent
    visc_min                = 1e3           ! [Pa a] Minimum allowed viscosity
    enh_method              = "shear3D"     ! "simple","shear2D", "shear3D", "paleo-shear"
    enh_shear               = 3.0
    enh_stream              = 1.0
    enh_shlf                = 0.7
    enh_umin                = 50.0          ! [m/yr] Minimum transition velocity to enh_stream (enh_method="paleo-shear")
    enh_umax                = 500.0         ! [m/yr] Maximum transition velocity to enh_stream (enh_method="paleo-shear")
    tracer_method           = "expl"        ! "expl", "impl": used for age and 'paleo-shear' enh fields
    tracer_impl_kappa       = 1.5           ! [m2 a-1] Artificial diffusion term for implicit tracer solving

/

&ytherm
    qb_method       = 2                 ! 1: faces, 2: faces to quadrature nodes, 3: simple-stagger, 4: quadrature (1, 2: energy-consistent)
    dt_method       = "FE"              ! "FE", "AB", "SAM"
    solver_advec    = "impl-upwind"     ! "expl", "impl-upwind"
    gamma           = 1.0               ! [K] Scalar for the pressure melting point decay function
    strain_heating  = "full"          ! "full": from 3D viscosity and strain rate, "sia": SIA approx., "none": no strain heating
    use_const_cp    = False             ! Use specified constant value of heat capacity?
    const_cp        = 2009.0            ! [J kg-1 K-1] Specific heat capacity
    use_const_kt    = False             ! Use specified constant value of heat conductivity?
    const_kt        = 6.62e7            ! [J a-1 m-1 K-1] Thermal conductivity [W m-1 K-1 * sec_year] => [J a-1 m-1 K-1]
    enth_cr         = 1e-3              ! [--] Conductivity ratio for temperate ice (kappa_temp     = enth_cr*kappa_cold)
    omega_max       = 0.01              ! [--] Maximum allowed water content fraction

    rock_method     = "active"          ! "equil" (not active bedrock) or "active"
    nzr_aa          = 5                 ! Number of vertical points in bedrock
    zeta_scale_rock = "exp-inv"         ! "linear", "exp-inv"
    zeta_exp_rock   = 2.0
    H_rock          = 2000.0            ! [m] Lithosphere thickness
    rhoc_rock       = 2.0e6             ! [J m-3 K-1] Volumetric heat capacity of bedrock (rho*cp)
    kt_rock         = 6.3e7             ! [J a-1 m-1 K-1] Thermal conductivity of bedrock [W m-1 K-1 * sec_year] => [J a-1 m-1 K-1]
/

&yelmo_masks
    ! regions and basins come from the hub ([domain])
/

&yelmo_init_topo
    ! The initial topography comes from the hub ([domain])
    init_topo_state   = 0                                       ! 0: from file, 1: ice-free, 2: ice-free, rebounded
    z_bed_f_sd        = 0.0                                     ! Scaling fraction to modify z_bed = z_bed + f_sd*z_bed_sd
    smooth_H_ice      = 0.0                                     ! Smooth ice thickness field at loading time, with sigma=N*dx
    smooth_z_bed      = 0.0                                     ! Smooth bedrock field at loading time, with sigma=N*dx

/

&yelmo_data
    ! The present-day topography comes from the hub ([domain])
    pd_tsrf_load      = True
    pd_tsrf_path      = "ice_data/{domain}/{grid_name}/{grid_name}_MARv3.11-ERA_monmean_1961-1990_with_pr.nc"
    pd_tsrf_name      = "tas"                      ! Surface temperature (or near-surface temperature)
    pd_tsrf_monthly   = True
    pd_smb_load       = True
    pd_smb_path       = "ice_data/{domain}/{grid_name}/{grid_name}_MARv3.11-ERA_monmean_1961-1990_with_pr.nc"
    pd_smb_name       = "smb"                        ! Surface mass balance
    pd_smb_monthly    = True
    pd_vel_load       = True
    pd_vel_path       = "ice_data/ISMIP7/{domain}/{grid_name}/obs/{grid_name}_ObsISMIP7-v1.3.nc"
    pd_vel_names      = "vx_mosaic" "vy_mosaic"            ! Surface velocity
    pd_age_load       = False
    pd_age_path       = "ice_data/{domain}/{grid_name}/{grid_name}_STRAT-M15.nc"
    pd_age_names      = "age_iso" "depth_iso"        ! ages of isochrones; depth of isochrones

/

! ===== EXTERNAL LIBRARIES =====

&smbpal
    const_insol = True
    const_kabp  = 0.0
    insol_fldr  = "input"
    abl_method  = "itm"   ! "itm" or "pdd"
    sigma_snow  = 5.0     ! Standard deviation of temperature [K] over ice and snow
    sigma_melt  = 5.0     ! Standard deviation of temperature [K] in ablation zone
    sigma_land  = 5.0     ! Standard deviation of temperature [K] over land

    sf_a        = 0.273   ! Snow fraction function (parameter a)
    sf_b        = 273.6   ! Snow fraction function (parameter b)
    firn_fac    = 0.0266  ! Reduction in surface temp versus melting [K/mm w.e.]

    mm_snow = 3.0         ! PDD snow melt factor [mm w.e./K-d]
    mm_ice  = 8.0         ! PDD ice melt factor  [mm w.e./K-d]

/

&itm

    H_snow_max      =  5.0e3         ! Maximum allowed snowpack thickness [mm w.e.]
    Pmaxfrac        =  0.6           ! Refreezing factor

    ! ## ITM
    trans_a         =  0.46
    trans_b         =  6e-5
    trans_c         =  0.01
    itm_c           = -45.0
    itm_t           =  10.0
    itm_b           =  -2.0
    itm_lat0        =  65.0

    ! ## Surface albedo
    alb_snow_dry       =  0.8
    alb_snow_wet       =  0.65
    alb_ice            =  0.4
    alb_land           =  0.2
    alb_forest         =  0.1
    alb_ocean          =  0.1
    H_snow_crit_desert =  10.0
    H_snow_crit_forest = 100.0
    melt_crit          =   0.5      ! Critical melt rate to reduce snow albedo [mm/day]

/

&itm_chion
    ! chion's ITM parameters: [itm] with alb_ice calibrated to MAR v3.11 1961-1990
    ! (GRL-8KM, fixed present-day geometry: runoff and ablation-zone smb).

    H_snow_max      =  5.0e3         ! Maximum allowed snowpack thickness [mm w.e.]
    Pmaxfrac        =  0.6           ! Refreezing factor

    ! ## ITM
    trans_a         =  0.46
    trans_b         =  6e-5
    trans_c         =  0.01
    itm_c           = -45.0
    itm_t           =  10.0
    itm_b           =  -2.0
    itm_lat0        =  65.0

    ! ## Surface albedo
    alb_snow_dry       =  0.8
    alb_snow_wet       =  0.65
    alb_ice            =  0.31
    alb_land           =  0.2
    alb_forest         =  0.1
    alb_ocean          =  0.1
    H_snow_crit_desert =  10.0
    H_snow_crit_forest = 100.0
    melt_crit          =   0.5      ! Critical melt rate to reduce snow albedo [mm/day]

/

&surface_chion
    ! Host side of chion (surface_method = "chion"): forcing chion does not own.
    const_insol = True    ! Insolation at const_kabp instead of the model time
    const_kabp  = 0.0     ! [kyr BP] Insolation time when const_insol
    insol_fldr  = "input" ! Folder of the orbital-parameter tables
    sf_a        = 0.273   ! Snow fraction function (parameter a)
    sf_b        = 273.6   ! Snow fraction function (parameter b)
    sigma_pdd   = 5.0     ! [K] Temperature standard deviation for the annual PDDs
    time_equil  = 100.0   ! [yr] Cold-start snowpack spin-up (annual cycles)
    dt_days     = 1       ! [d] chion step (divides the 360-day year)
    trans_sw    = 0.6     ! [1] TOA -> surface shortwave transmissivity (bessi)
    wind_speed  = 5.0     ! [m s-1] Constant wind speed (bessi)
    rel_hum     = 0.8     ! [1] Constant relative humidity (bessi)
/

&chion
    model           = "itm"                          ! Snowpack model: "itm" or "bessi"
    nml_itm         = "itm_chion"                    ! ITM parameters (chion's own group)
/

&marine_shelf
    bmb_method      = "anom" ! "pico", "anom", "lin", "quad", "quad-nl", "*-slope"
    tf_method       = 2             ! 0: tf defined externally, 1: calculate as T_shlf-t_fp_shlf, 2: use dT_shlf
    interp_depth    = "shlf"        ! "shlf", "bed", "const"
    interp_method   = "interp"      ! "mean", "layer", "interp" ! Same method is used for salinity
    find_ocean      = True          ! Find which points are connected to open ocean (ie, ignore subglacial lakes)
    restart         = "none"        ! Load fields from a restart file?
    extrap_shlf     = False         ! Extrapolate ocean front values into the shelf
                                    ! Useful to account for moving ice fronts and/or filling mv in datasets

    corr_method     = "none"          ! "tf": corrected tf basin, "bmb": corrected bmb basin, "tf-ant": use values in tf_corr_ant parameter section
    basin_number    = 1
    basin_bmb_corr  = 0.0           ! -1.0  -1.0 -1.0 [corrected bmb m/yr; -: melting, +: accretion]
    basin_tf_corr   = 0
    tf_correction   = False
    tf_path         = "ice_data/ISMIP6/{domain}/{grid_name}/Ocean/{grid_name}_OCEAN_ISMIP6_J20.nc"
    tf_name         = "dT_nl"

    bmb_max         = 0.0           ! [m/a] Maximum allowed bmb value (eg, for no refreezing, set bmb_max=0.0)

    ! Deep ocean bmb
    c_deep          = -10.0         ! [m/yr] Melt rate in deep ocean, should be negative but not huge
    depth_deep      = 500.0        ! [m] Depth at which deep ocean is assumed
    depth_const     = 320.0        ! [m] Constant shelf depth for interp_depth=const
    depth_min       = 320.0        ! [m] interp_method=mean, min depth to include
    depth_max       = 330.0        ! [m] interp_method=mean, max depth to include

    ! Freezing point coefficients
    lambda1         = -0.0575       ! [degC PSU−1] Liquidus slope
    lambda2         = 0.0832        ! [degC] Liquidus intercept
    lambda3         = 7.59e-4       ! [degC m−1] Liquidus pressure coefficient

    ! bmb_method == [lin,quad,quad-nl]
    gamma_lin       = 630.0         ! [m/yr] Linear heat excange velocity. Favier et al., (2019) suggest 630.
    gamma_quad      = 14.5e3       ! [m/yr] Quadratic heat exchange velocity. Jourdain et al. (2020) suggest 11100.
    gamma_quad_nl   = 14.5e3        ! [m/yr] Quadratic non-local heat exchange velocity. Jourdain et al. (2020) suggest 14500.
    gamma_prime     = 100.0         ! [-] Scalar when '*-slope' method is used

    ! bmb_method == anom
    kappa_grz       = 10.0          ! [m/yr K-1] Heat flux coefficient [kappa*dT]
    c_grz           = 1.0           ! [-] bmb_ref scalar [c_grz*bmb_ref]
    f_grz_shlf      = 10.0          ! [-] Ratio of grz melt to shelf melt
    grz_length      = 32.0          ! [km] Length scale of assumed grounding zone

    ! bmb_method == anom, bmb_ref parameters
    use_obs         = False         ! Load obs for bmb_ref
    obs_path        = "ice_data/{domain}/{grid_name}/{grid_name}_BMELT-R13.nc"
    obs_name        = "bm_eq_reese"
    obs_scale       = 50           ! [-] bmb_ref = obs_scale*bmb_obs
    obs_lim         = 100.0         ! [m/yr] Maximum magnitude of bmb_ref

/

&tf_corr_ant
    ronne   = 0.0                   ! [K] tf_corr for ronne basin (basin=1)
    ross    = 0.0                   ! [K] tf_corr for ross basin (basin=12)
    pine    = 0.0                   ! [K] tf_corr for pine island (basin=14)
    abbott  = 0.0                   ! [K] tf_corr for Abbott glacier (basin=15)
/


&pico
    n_box          = 5.0        ! Maximum number of boxes in PICO.
    a_pico         = -0.0572    ! Salinity coefficient of freezing equation [ºC/PSU]. Reese et al., (2018) suggest −0.0572.
    b_pico         = 0.0788     ! Constant coefficient of freezing equation [ºC]. Reese et al., (2018) suggest 0.0788.
    c_pico         = 7.77e-8    ! Pressure coefficient of freezing equation [ºC/Pa]. Reese et al., (2018) suggest 7.77e-8.
    alpha_pico     = 7.5e-5     ! Thermal expansion coefficien [1/ºC]. Reese et al., (2018) suggest 7.5e-5.
    beta_pico      = 7.7e-4     ! Salt contraction coefficient [1/PSU]. Reese et al., (2018) suggest 7.7e-4.
    rho_star       = 1033.0     ! Reference density [kg/m3]. Reese et al., (2018) suggest 1033.0.
    gamma_tstar    = 1500.0      ! Effective turbulent temperature exchange velocity [m/yr]. Reese et al., (2018) uses 630.0 and suggest 600-1000.
    C_over         = 2.0        ! Overturning strength [Sv m3/kg]. Reese et al., (2018) suggest 1.0.

/

&sed
    method    = 1               ! 0: no sediments, H_sed=0; 1: read sediments from observations
    obs_path  = "ice_data/{domain}/{grid_name}/{grid_name}_SED-L97.nc"
    obs_name  = "z_sed"

/

&ghf
    use_obs   = True
    obs_path  = "ice_data/ISMIP7/{domain}/{grid_name}/obs/{grid_name}_ObsISMIP7-v1.3.nc"
    obs_name  = "geothermal_heat_flux1"
    obs_err_name = "none"
    convert_ghf_units = True   ! True converts from W/m^2 to mW/m^2, False does nothing
    f_stdev   = 0.0
    ghf_const = 50.0           ! [mW/m^2]

/

&isos
    ! Options
    heterogeneous_ssh = .true.      ! Sea level varies spatially?
    interactive_sealevel = .true.   ! Sea level interacts with solid Earth deformation?
    include_elastic = .true.        ! Include elastic deformation?
    correct_compression = .true.    ! Account for compression effects on relaxation time?
    correct_distortion = .false.    ! Account for distortion of projection?
    method          = 3             ! 0: constant displacement; 1: LLRA; 2: LV-ELRA, 3: LV-ELVA
    dt_diagnostics  = 10.           ! [yr] Min. timestep to recalculate diagnostics
    pad         = 512.             ! [km] Padding around the domain (preferably chosen as a power
                                    ! of 2 multiplied by the resolution)


    ! Rheology methods
    mantle = "uniform"        ! Choose mantle viscosity field, options:
                                    ! "uniform", "gaussian_plus", "gaussian_minus", "rheology_file"
    lithosphere = "uniform"   ! Choose lithospheric thickness field:
                                    ! "uniform", "gaussian_plus", "gaussian_minus", "rheology_file"
    layering    = "equalized"        ! "parallel" or "equalized"
    lumping     = "min"             ! "bottom", "min", "max", "mean", "logmean", "freqdomain"
    viscosity_scaling_method = "scale"  ! "scale" or "min" or "max"
    viscosity_scaling = 1.              ! Only used if viscosity_scaling_method = "scale"

    ! Rheology parameters
    nl          = 2             ! [1] Number of viscous layers for sub-lithospheric mantle
    dl          = 25.               ! [km] Thickness of viscous layers. Only used if layering="parallel".
    zl          = 88.0 600.0     ! [km] Depth of layer boundaries.
                                    ! Only used if layering="equalized". First value
                                    ! overwritten if visc_method="rheology_file".
    viscosities = 1e21, 2e21     ! [Pa s] Layer viscosities. Only used if
                                    ! mantle = "uniform" or "gaussian_plus" or "gaussian_minus".
                                    ! viscosity field is provided.
    ref_viscosity = 1.e21       ! [Pa s] Reference viscosity for scaling
    tau = 2000.0                ! [yr] Relaxation time used for "method" = 2
    rheo_smoothing_radius = 40.0! [km] Gaussian moothing radius for lithospheric thickness
                                ! and mantle viscosity
    litho_thickness_scaling = 1.0   ! Scaling factor for lithospheric thickness. Only used if lithosphere = "rheology_file"

    ! Physical constants
    E               = 66.0          ! [GPa] Young modulus
    nu              = 0.28          ! [-] Poisson ratio
    rho_litho       = 3200.0        ! [kg/m^3]  Optionally set to 0 ==> decouple the elastic
                                    ! displacement from the viscous one
    r_earth         = 6.378e3       ! [km] Earth radius, Coulon et al. (2021)
    m_earth         = 5.972e24      ! [kg] Earth mass,   Coulon et al. (2021)

    ! Files
    restart = "None"
    mask_file = "None"
    rheology_file = "none"
    litho_thickness_varname = "litho_thickness" ! Variable name in netcdf file
    log10_viscosity_varname = "log10_visc"       ! Variable name in netcdf file
    stddev_log10_viscosity_varname = "stddev_log10_visc"     ! Variable name in netcdf file


    ! Time stepping
    dt_method = "tsit54"    ! Time stepping method, options: "euler", "rk4", "bs32", "tsit54"
    dt_init = 1.0           ! [yr] Initial time step for time stepping method. If dt_method
                            ! is "euler" or "rk4", this value is used throughout the simulation.
                            ! If dt_method is "bs32" or "tsit54", the time step is adapted
                            ! during the simulation, and this value is only used as an initial guess.
    dt_min = 1e-10          ! [yr] Minimum dt. Only used if dt_method is "bs32" or "tsit54".
    dt_max = 10.0           ! [yr] Maximum dt. Only used if dt_method is "bs32" or "tsit54".
    rtol = 1e-4             ! Relative tol. Only used if dt_method is "bs32" or "tsit54".
    atol = 1e-2             ! Absolute tol. Only used if dt_method is "bs32" or "tsit54".
    q = 1.0                 ! Exponent for dt adaptation. The higher the most conservative the time stepping.
/

&barysealevel
    method      = "fastiso" ! "const": BSL = bsl_init throughout sim
                            ! "file": BSL = time series provided from sl_path
                            ! "fastiso": BSL = sum of contributions from fastiso domains
    bsl_init    = 0.0       ! [m] BSL relative to present day
    sl_path     = "input/paleo300ka_hybrid_aicc2012.nc"    ! Input time series filename
    sl_name     = "none"    ! Variable name in netcdf file, if relevant
    A_ocean_pd  = 3.625e14  ! [m^2] Ocean surface as in Goelzer et al. (2020)
    A_ocean_path = "isostasy_data/tools/ocean_surface/OceanSurfaceETOPO2022.nc"
    restart    = "None"
/

&domain
    ! Domain definition: name, the grid of every component, and the hub's
    ! topography and code masks ({grid_name} in the paths = grid_hub).
    ! A blank component grid takes the default given in brackets.
    name         = "Greenland"
    phys_const   = "Earth"            ! physical constants: group of input/yelmo_phys_const.nml
    grid_hub     = "GRL-8KM"          ! hi-res geometry hub
    grid_ice     = ""                 ! Yelmo [grid_hub]
    grid_isos    = ""                 ! isostasy [grid_ice]
    grid_clim    = ""                 ! reference climate + transient forcing [grid_ice]
    grid_surface = ""                 ! surface mass balance [grid_clim]
    grid_shelf   = ""                 ! marine shelf [grid_hub]
    topo_path    = "ice_data/ISMIP7/{domain}/{grid_name}/obs/{grid_name}_ObsISMIP7-v1.3.nc"
    topo_names   = "bed" "thickness" "surface_grimp" ""  ! z_bed, H_ice, z_srf, z_bed_sd ("" = none)
    regions_path = "ice_data/{domain}/{grid_name}/{grid_name}_REGIONS.nc"  ! "" = none (regions = 1)
    regions_var  = "mask"
    basins_path  = "ice_data/ISMIP7/{domain}/{grid_name}/obs/{grid_name}_ObsISMIP7-v1.3.nc"  ! "" = none (basins = 1)
    basins_var   = "mouginot_basins"
    sectors_path = ""                ! "" = none (sectors = 1)
    sectors_var  = ""
    ice_codes_mode = "include"       ! where ice is allowed: "all", "include" (only on ice_codes), "exclude" (all but ice_codes)
    ice_codes    = 1.3 1.11 1.0      ! codes of regions ("" = none)
    region_names = ""                ! named regions for 1D output, yelmo_ts_<name>.nc ("" = none)
    region_mask  = "regions"         ! code mask of the named regions: regions, basins or sectors
    region_codes = ""                ! one code per named region
    relax_codes_mode = "none"        ! where ice relaxes to the reference (ytopo.topo_rel = -1): none, all, include, exclude
    relax_codes  = ""                ! codes of regions ("" = none)
    relax_tau    = 0.0               ! [yr] relaxation timescale there
/

&comps
    ! Components: which are active, with which model, how often.
    ! Empty grids default to the Yelmo grid, so esm (grid_clim), smbpal
    ! (grid_surface) and marine_shelf (grid_shelf) all run on the Yelmo grid
    ! (identity remaps = exact parity). Set grid_clim to a coarse ESM grid to run
    ! the ESM forcing on its own grid; its outputs remap to the consumer grids.
    with_ice_sheet    = True   ! Is the ice sheet active?
    with_isostasy     = True   ! Is isostasy active?
    with_climate      = True   ! Is the climate (atmosphere + ocean) active?
    with_surface      = True   ! Is the surface (mass balance + temperature) active? Needs with_climate
    with_shelf        = True   ! Is the shelf base (melt + temperature) active? Needs with_climate
    climate         = "esm"      ! climate backend: "snapclim", "snapesm", "esm" or "rembo"
    surface_method  = "chion"  ! "chion", "smbpal", "smb_simple" or "climate"
    dt_clim         = 1.0      ! [yr] climate update interval (esm: every step, = dtt)
/

&sim
    ! Conditions of this simulation: cold-start ice state (init_*),
    ! relaxation, optimization, regional modifications.
    init_method             = "equil"   ! cold start: none, equil, recon (from recon_path), recon_ref (recon_path as reference ice only)
    init_equil_time         = 1.0       ! [yr] equil: equilibration time
    init_marine_H           = False     ! LGM-like marine ice at cold start (before init_method)
    init_kill_shelves       = False     ! cold start: no ice where the present-day bed is ocean
    init_time_thrm          = 0.0       ! [yr] cold start: then equilibrate with topography fixed

    relax                   = False     ! relax the topography towards the reference ([relax])
    opt                     = False     ! optimize cb_ref and tf_corr ([opt])

    use_negis               = False   ! NEGIS cb_ref modification (needs [negis] group)
    scale_glacial_smb       = False   ! Reduce negative glacial smb (needs [glacial_smb] group)
    lim_pd_ice              = False   ! Extra melt outside PD ice extent
/

&output
    write_yelmo   = True
    write_isos    = True
    write_shelf   = True
    write_surface = True
    write_clim    = False        ! the climate's file (snap.nc; esm.nc + esm_ts.nc)
    write_htopo   = True
    write_cmip    = False        ! CMIP/ISMIP-formatted output (yelmo_cmip.nc, yelmo_ts_cmip.nc)
    dt_cmip       = 1.0          ! [yr] its interval
/
