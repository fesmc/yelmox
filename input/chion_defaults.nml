! ============================================================
! chion_defaults.nml — canonical defaults for all chion groups.
! ============================================================
!
! THIS FILE IS THE SCHEMA. Every parameter the chion library reads
! must be declared here, and every read goes through nml_read with
! defaults_file = this file. Two consequences:
!
!   * a parameter the code reads but this file does not declare is
!     a hard error on every run, not a silent zero;
!   * a user par file may be SPARSE — it only lists overrides, and
!     anything it omits comes from here. Names it uses that are NOT
!     declared here are reported by nml_validate (i.e. typos are
!     caught rather than ignored).
!
! Physical constants are split (docs/porting_notes.md D28):
!   * chion's own (snow, albedo, SEB, scheme flags) are &chion_const
!     below, read like every other group here;
!   * the SHARED ones (rho_ice, rho_w, cp_ice, cp_w, L_ice, g, T0) come
!     from the host's fesm-utils phys_const_class, or, standalone, from
!     &chion:phys_const_file, which is in the phys_const schema and must
!     be complete.
!
! Layout follows yelmo: value at column ~22, comment at column ~42.
! Enumerated parameters list their allowed values in the comment.
!
! Sources of truth for the defaults:
!   Chion.jl/src/models.jl      BESSIModel, PDDModel keyword defaults
!   Chion.jl/src/constants.jl   DEFAULT_NTOT etc.
!   smbpal/src/smb_itm.f90      the ITM parameters
!   smbpal/par/smbpal.nml       the ITM default values
! ============================================================


! ============================================================
! &chion — top-level configuration
! ============================================================

&chion
    model            = "bessi"              ! Snowpack model: "bessi" | "pdd" | "itm"
    nml_bessi        = "bessi"              ! Namelist group holding the BESSI parameters
    nml_pdd          = "pdd"                ! Namelist group holding the PDD parameters
    nml_itm          = "itm"                ! Namelist group holding the ITM parameters
    nml_const        = "chion_const"        ! Namelist group holding chion's own constants
    phys_const_file  = "input/chion_phys_const.nml"   ! Shared constants, standalone only
    phys_const       = "Earth"              ! Group within phys_const_file
    restart          = "None"               ! Restart file, or "None" for a cold start (WP14)
/

! Notes on &chion
!
! model
!   Selects which snowpack model is allocated and stepped. Only the
!   selected model's state is allocated and only its parameter group
!   is read, so an unused group may be absent or wrong without effect.
!
! nml_bessi / nml_pdd / nml_itm / nml_const
!   The group NAMES, so that chion can be instantiated more than once
!   in one executable with disjoint parameter sets. Whatever they are
!   renamed to is still validated against the "bessi" / "pdd" / "itm" /
!   "chion_const" groups of THIS file (nml_read's defaults_group).
!
! phys_const_file / phys_const
!   Read only when the host passes no phys_const_class to chion_init.
!   The file is fesm-utils' phys_const schema (phys_const_load, no
!   defaults): the group must declare all 12 primitives.


! ============================================================
! &chion_const — chion's own physical constants and scheme flags
! ============================================================
!
! The fields of chion_const_class other than the shared ones. The
! Chion.jl-derived ones mirror SnowpackPhysicalConstants
! (src/constants.jl:61-88) with Chion.jl's defaults
! (src/constants.jl:173-200); the SEMIX blocks are additions with
! CLIMBER-X values, inert unless the matching scheme is selected.
!
! WHY THE SCHEME FLAGS ARE HERE and not in &bessi: Chion.jl keeps them
! inside SnowpackPhysicalConstants, and every chion physics routine
! already receives the constants object. See docs/porting_notes.md D3
! and D4.

&chion_const

    ! ## Densities ##
    rho_s                     = 315.0       ! [kg m-3] Fresh snow density (constant scheme)

    ! ## Parameterized fresh-snow density ##
    ! rho = rho_s_a + rho_s_b*(T-T0) + rho_s_c*sqrt(max(wind,0)),
    ! clamped to [50, rho_i]. Used only by the "parameterized" scheme.
    rho_s_a                   = 109.0       ! [kg m-3] Intercept
    rho_s_b                   = 6.0         ! [kg m-3 K-1] Temperature slope
    rho_s_c                   = 26.0        ! [kg m-3 (m s-1)^-1/2] Wind slope
    fresh_snow_density_scheme = "constant"  ! "constant" | "parameterized" (aliases: "bessi", "htessel")

    ! ## Thermal properties ##
    Ki                        = 2.1         ! [W m-1 K-1] Thermal conductivity of ice
    Lv                        = 2.501e6     ! [J kg-1] Latent heat of vaporization
    cp_air                    = 1003.0      ! [J kg-1 K-1] Heat capacity of air
    latent_heat_flux_ratio    = 1.0         ! [1] Scaling of the turbulent latent flux

    ! ## Turbulent exchange ##
    D_sh                      = 10.0        ! [W m-2 K-1] Sensible heat exchange coefficient

    ! ## Surface energy balance (CLIMBER-X SEMIX aerodynamic scheme) ##
    ! seb_scheme = "bessi" uses D_sh above and ignores everything below it.
    seb_scheme                = "bessi"     ! "bessi" | "semix"
    z0m_snow                  = 0.0024      ! [m]  Momentum roughness length, snow
    z0m_ice                   = 0.002       ! [m]  Momentum roughness length, ice
    zm_to_zh                  = 0.13533528  ! [1]  Heat/momentum roughness ratio, exp(-2)
    z_sfl                     = 100.0       ! [m]  Surface layer height
    karman                    = 0.4         ! [1]  von Karman constant
    R_dry                     = 287.058     ! [J kg-1 K-1] Gas constant of dry air
    l_neutral                 = .FALSE.     ! [1]  Force neutral stratification?
    l_dew                     = .TRUE.      ! [1]  Allow dew/frost deposition?
    semix_qsat                = "semix"     ! "semix" | "bessi" (aliases: "climberx", "chion")

    ! ## Albedo ##
    alpha_dry                 = 0.81        ! [1] Dry snow albedo (upper bound)
    alpha_wet                 = 0.70        ! [1] Wet snow albedo (lower bound)
    alpha_ice                 = 0.30        ! [1] Bare ice albedo
    max_lwc_albedo            = 0.10        ! [1] LWC at which the albedo reaches alpha_wet
    albedo_scheme             = "dynamic"   ! "constant" | "dynamic" | "prescribed" | "semix" (aliases: "bessi", "legacy")

    ! ## SEMIX spectral albedo (albedo_scheme = "semix"; CLIMBER-X) ##
    frac_vu                   = 0.45        ! [1]  Visible+UV fraction of incoming solar
    alb_snow_vis_new          = 0.99        ! [1]  Fresh-snow visible diffuse albedo
    alb_snow_nir_new          = 0.65        ! [1]  Fresh-snow near-IR diffuse albedo
    snow_grain_fresh          = 50.0        ! [um] Fresh snow grain size
    snow_grain_old            = 1000.0      ! [um] Aged snow grain size
    d_alb_age_vis             = 0.05        ! [1]  Visible aging albedo reduction
    d_alb_age_nir             = 0.25        ! [1]  Near-IR aging albedo reduction
    f_age_t                   = 0.1         ! [K-1] Dry-snow temperature aging factor
    dT_age                    = 0.0         ! [K]  Aging temperature offset
    snow_0                    = 1.0         ! [kg m-2 d-1] Critical snowfall rate for grain aging
    snow_1                    = 0.5         ! [1]  Snowfall-rate aging exponent
    w_snow_dust               = 10.0        ! [kg m-2] SWE melt that doubles dust concentration
    dust_con_scale            = 1.0         ! [1]  Dust concentration scaling
    semix_snow_albedo         = "dang"      ! "ww" | "dang" (CLIMBER-X default: Dang 2015)
    dalb_snow_vis             = 0.0         ! [1]  Visible snow albedo offset (Dang)
    dalb_snow_nir             = 0.0         ! [1]  Near-IR snow albedo offset (Dang)
    k_sigma_orog              = 0.0         ! [1]  Orographic albedo reduction scale (Dang)
    sigma_orog_crit           = 1000.0      ! [m]  Orographic roughness scale (Dang)

    ! ## Radiation ##
    eps_air                   = 0.80        ! [1] Emissivity of air
    eps_snow                  = 0.98        ! [1] Emissivity of snow
    eps_ice                   = 0.98        ! [1] Emissivity of bare ice (seb_scheme = "semix" only)
    sigma_sb                  = 5.670373e-8 ! [W m-2 K-4] Stefan-Boltzmann constant

    ! ## Densification ##
    low_density_densification = "bessi"     ! "bessi" | "htessel" (selects the rho<550 branch only)

/

! Notes on &chion_const
!
! max_lwc_albedo
!   Distinct from percolation's max_lwc, which is a hard-coded 0.1 in
!   snow_percolation.f90. The two happen to share a value and are NOT
!   the same parameter (docs/PLAN.md section 5 item 4).
!
! albedo_scheme = "prescribed"
!   Takes the DYNAMIC code path inside the albedo routines and is then
!   overridden by the caller. If forc%has_prescribed_albedo is false it
!   silently behaves as "dynamic" (docs/PLAN.md section 5 item 9).
!
! low_density_densification
!   Selects only the rho < 550 kg m-3 branch. The mid and high branches
!   are the same either way. Chion.jl dispatches this with an if/else on
!   HTESSEL only, so any unrecognised value silently selects BESSI;
!   chion rejects unknown names instead (docs/porting_notes.md D5).
!   Note the HTESSEL thermal-metamorphism term is dead above
!   ~150 kg m-3 (upstream defect 3).
!
! Constants NOT configurable, on purpose, because Chion.jl hard-codes
! them inside the physics and they are carried over verbatim:
!   densification's gravity (DENSIFY_GRAVITY, not the shared g; D25);
!   its gas constant (DENSIFY_R_GAS; D22); rho_e = 815; P_atm = 101325;
!   the 550/800 density regime thresholds; the vapor-pressure
!   coefficients; obliquity 23.439291; the albedo aging coefficients.
!   See docs/PLAN.md section 5 item 3.


! ============================================================
! &bessi — layered energy-balance snowpack (Chion.jl BESSIModel)
! ============================================================
!
! Layer arrays are (Ntot,ncol), layer 1 = surface, increasing downward.
! The mass partition is validated by bessi_par_validate and is not
! merely cosmetic:
!     mass_split < mass_max        else the split loop cannot converge
!     mass_min   < mass_split      else a split immediately re-merges
!     mass_split/mass_max >= 0.5   else merge_surface_layer's unguarded
!                                  divisor can reach zero (upstream
!                                  defect 8, docs/porting_notes.md)

&bessi
    Ntot             = 15                   ! [1] Layer capacity per column
    mass_max         = 500.0                ! [kg m-2] Surface-layer mass that triggers a split
    mass_split       = 300.0                ! [kg m-2] Mass left in the layer below after a split
    mass_min         = 100.0                ! [kg m-2] Surface-layer mass that triggers a merge
    density_init     = 300.0                ! [kg m-3] Density assigned to an inactive layer slot
    temperature_init = 273.0                ! [K] Temperature assigned to an inactive layer slot

    diurnal_shortwave_substeps            = False   ! [1] Resolve the diurnal cycle by substepping
    diurnal_shortwave_threshold           = 0.0     ! [W m-2] Peak-minus-mean excess required to substep
    diurnal_shortwave_max_substeps        = 3       ! [1] Substeps per day when enabled; 1..24
    diurnal_shortwave_min_air_temperature = 265.15  ! [K] Below this, do not substep (Julia: -8 C)
    diurnal_temperature_cycle             = False   ! [1] Impose a diurnal air-temperature cycle
    diurnal_temperature_amplitude         = 5.0     ! [K] Half-amplitude of that cycle
/

! Notes on &bessi
!
! diurnal_shortwave_substeps
!   OFF by default, and that is a physics choice rather than a
!   performance one. The albedo aging law carries no dt
!   (docs/PLAN.md section 5 item 5), so enabling substepping ages the
!   albedo max_substeps times per day — upstream defect 19. Snowfall
!   brightening is likewise nonlinear under substepping (defect 21).
!   Enabling this changes the albedo scheme, not only the shortwave
!   resolution.
!
! Ntot
!   The snow-depth cap uses a hard-coded reference layer count of 15
!   REGARDLESS of Ntot (docs/PLAN.md section 5 item 11). Changing Ntot
!   therefore does not move the depth cap.
!
! The three sub-scheme choices — albedo_scheme, fresh_snow_density_scheme
! and low_density_densification — are NOT here. They live in the
! constants file, mirroring Chion.jl's SnowpackPhysicalConstants
! (docs/porting_notes.md D3).


! ============================================================
! &pdd — bulk positive-degree-day model (Chion.jl PDDModel)
! ============================================================
!
! No layers, no energy balance. Read docs/PLAN.md section 3.2 and
! docs/pdd_defects.md before changing anything here: Chion.jl's PDD is
! known not to be fully working, and several of its behaviours are
! reproduced deliberately rather than fixed.

&pdd
    ddf_snow            = 3.0               ! [kg m-2 K-1 d-1] Degree-day factor for snow
    ddf_ice             = 8.0               ! [kg m-2 K-1 d-1] Degree-day factor for ice
    refreezing_fraction = 0.6               ! [1] Fraction of SNOW melt that refreezes
    temperature_sigma   = 5.0               ! [K] Std dev of unresolved temperature variability
    H_snow_max          = 5000.0            ! [kg m-2] Snowpack cap; the excess is converted to ice
    pdd_method          = "pism"            ! PDD integral: "simple" | "pism"
/

! Notes on &pdd
!
! pdd_method — DEFAULT DIVERGES FROM Chion.jl, deliberately.
!   "simple"  max(T-T0,0)*dt. Ignores sub-step temperature variability
!             entirely, so it produces no melt at all below freezing.
!   "pism"    the Calov–Greve expectation integral
!             dt*(sigma*phi(z) + Tbar*Phi(z)), z = Tbar/sigma.
!
!   Chion.jl selects between these IMPLICITLY on the timestep length
!   (27 <= dt_days <= 32 picks the integral) — a change of physics
!   triggered by a timestep, which chion replaces with this explicit
!   parameter (docs/pdd_defects.md D4).
!
!   chion defaults to "pism" rather than reproducing Chion.jl's daily
!   behaviour, per docs/PLAN.md section 3.1b item 5. The simple form
!   loses 1.25 kg m-2 d-1 of melt at -5 C and 5.98 kg m-2 d-1 at 0 C,
!   and that loss is concentrated exactly at the equilibrium line where
!   the ice-sheet response is most sensitive. smbpal, which is the
!   scheme actually in production use in yelmox, always uses the
!   integral. Set pdd_method = "simple" to recover Chion.jl's daily
!   path for a line-by-line comparison.
!
! refreezing_fraction
!   Applied to snow melt with NO cold-content and NO capacity limit
!   (upstream defect 5), and the refrozen mass re-enters the meltable
!   reservoir (defect 6). smbpal instead caps refreezing at
!   min(melt_snow, acc*f_refrz_max). Reproduced, not fixed.


! ============================================================
! &itm — insolation-temperature melt model (from smbpal)
! ============================================================
!
! Ported from smbpal/src/smb_itm.f90, NOT from Chion.jl, which has no
! ITM. Because chion is to replace smbpal in yelmox, these defaults are
! smbpal's, and the acceptance criterion is equivalence with smbpal.
!
! The values below are taken verbatim from the &itm group of
! yelmox/yelmox/yelmox_Greenland.nml — the configuration chion has to
! reproduce at the WP19 cutover — and match the values tests/test_itm.f90
! uses. Note itm_b and itm_lat0 are therefore Greenland-tuned: a
! different domain should override them, or set itm_lat0 = 90.0 to
! disable the latitude dependence entirely.
!
! ITM does not compute insolation. The host supplies it, through
! forc%q_sw_net (preferred) or forc%shortwave_down. It also needs
! forc%surface_height, forc%H_ice and forc%PDDs — the last being a
! WHOLE-YEAR degree-day total, recomputed once per year, not per step.

&itm
    trans_a             = 0.46              ! [1] Atmospheric transmissivity, intercept
    trans_b             = 6e-5              ! [m-1] Transmissivity elevation slope
    trans_c             = 0.01              ! [1] Unused by the active transmissivity form
    itm_c               = -45.0             ! [W m-2] ITM offset
    itm_t               = 10.0              ! [W m-2 K-1] ITM temperature coefficient
    itm_b               = -2.0              ! [W m-2 deg-1] Latitude slope of itm_c
    itm_lat0            = 65.0              ! [deg N] Reference latitude; |lat0| >= 90 disables
    H_snow_max          = 5000.0            ! [mm w.e.] Snowpack cap
    Pmaxfrac            = 0.6               ! [1] Refreezing factor
    H_snow_crit_desert  = 10.0              ! [mm w.e.] Critical snow depth, PDDs <= 100
    H_snow_crit_forest  = 100.0             ! [mm w.e.] Critical snow depth, PDDs >= 1000
    melt_crit           = 0.5               ! [mm d-1] Melt rate at which snow albedo goes wet
    alb_ocean           = 0.1               ! [1] Albedo of open ocean
    alb_land            = 0.2               ! [1] Albedo of ice-free land
    alb_forest          = 0.1               ! [1] Albedo of forest
    alb_ice             = 0.4               ! [1] Albedo of bare ice
    alb_snow_dry        = 0.8               ! [1] Albedo of dry snow
    alb_snow_wet        = 0.65              ! [1] Albedo of wet snow
    firn_fac            = 0.0266            ! [K (mm w.e. yr-1)-1] Firn warming per annual net refreezing
/

! Notes on &itm
!
! trans_c
!   Read and stored but never used: smbpal's three-argument
!   transmissivity call is commented out in favour of the two-argument
!   sqrt-elevation form (smb_itm.f90:116). Kept so the parameter set
!   matches smbpal's exactly.
!
! itm_lat0
!   |itm_lat0| >= 90 disables the latitude dependence of itm_c
!   entirely, which is what the default does.
!
! H_snow_crit_desert
!   Has no zero guard in smbpal; a value of 0 divides by zero
!   (upstream smbpal defect 3). Do not set it to zero.
!
! firn_fac
!   Lives in smbpal_param_class, not in smbpal's itm_par_class, because
!   smbpal applies the surface-temperature adjustment once per year
!   outside the ITM module. chion computes it inside itm_step, so the
!   parameter travels with the ITM parameters. It is calibrated against the
!   ANNUAL net melt [mm w.e. yr-1] on a 360-day year; itm_step scales its
!   per-step rate accordingly.
!
! ITM takes rho_w, L_m and T0 from the shared constants, like the other
! models (docs/porting_notes.md D26, D28). itm_c and itm_t were
! calibrated in smbpal against L_m = 3.35e5 J kg-1, so a host's L_ice
! shifts ITM melt by the ratio of the two.
