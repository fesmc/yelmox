    name     = "t2m_mon_anom"
    units    = "K" "K"
    scaling  = 1.0 0.0
    time     = 0 0 0 0 1
    remap    = "bilin"
    grid_src = "{grid_global}"
/

&cx_pr_mon_anom
    filename = "fesmdata/Global/{grid_global}/{grid_global}_Paleoclimate-CLIMBERX-Willeit2025-{exp}.nc"
    name     = "pr_mon_anom"
    units    = "mm d-1" "mm d-1"
    scaling  = 1.0 0.0
    time     = 0 0 0 0 1
    remap    = "bilin"
    grid_src = "{grid_global}"
/

&cx_to
    filename = "fesmdata/Global/{grid_global}/{grid_global}_Paleoclimate-CLIMBERX-Willeit2025-{exp}-ocean.nc"
    name     = "to"
    units    = "degC" "K"
    scaling  = 1.0 273.15
