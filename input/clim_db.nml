! =====================================================================
! clim_db.nml — shared climate database (varslice groups) for the snapshot
! backend (snapesm) and the climate modifiers.
!
! One group per product field. A par file lists the databases to search,
! first file that has a group wins, then the par file itself (searched
! implicitly last: it can hold run-specific groups without naming itself):
!     &snap
!         var_defs = "input/clim_db.nml"
! A snapshot binds groups by name: &snap_lgm  exp = "lgm"
! tas = "pmip3_mean_tas_ann" "pmip3_mean_tas_jja".
!
! Path keywords:
!   {domain}, {grid_name}  the domain ([domain] name) and the climate grid
!   {grid_global}          the global grid of the paleoclimate products,
!                          [snap] grid_global (default GLOBAL-1DEG)
!   {exp}                  the experiment of the snapshot, its exp key
!                          (lgm, piControl, present, stadial, ...)
! Present-day references are regional ({domain}/{grid_name}, high
! resolution); paleoclimate snapshots are global products, remapped online
! onto the climate grid (remap = "bilin", map cached in maps/).
!
! Compact varslice format: units = "in" "out"; scaling = scale offset
! (var*scale + offset, so degC -> K uses offset 273.15); time = active x0 x1
! dx nsub (active >= 0.5: time axis; nsub > 1: sub-annual cycle, the last
! dimension; a monthly atmosphere (month, y, x) is read as is, nsub = 1).
! Optional: fill = "nearest" (missing values from the nearest valid cell, per
! level), remap + grid_src (online remap from the named grid).
! Units: temperatures in K, precipitation in mm d-1 (water equivalent), ocean
! temperature in K, salinity in PSU, elevations in m.
! =====================================================================

! ===== Present day: regional references =====

! ---- MAR v3.14, 1961-1990 (Greenland), monthly --------------------------

&mar314_1961_1990_tas
    filename = "fesmdata/{domain}/{grid_name}/{grid_name}_SMB-MARv3.14-1961-1990.nc"
    name     = "t2m"
    units    = "K" "K"
    scaling  = 1.0 0.0
    time     = 0 0 0 0 1
/

&mar314_1961_1990_sf
    filename = "fesmdata/{domain}/{grid_name}/{grid_name}_SMB-MARv3.14-1961-1990.nc"
    name     = "sf"
    units    = "kg m-2 yr-1" "mm d-1"
    scaling  = 2.73785e-3 0.0
    time     = 0 0 0 0 1
/

&mar314_1961_1990_rf
    filename = "fesmdata/{domain}/{grid_name}/{grid_name}_SMB-MARv3.14-1961-1990.nc"
    name     = "rf"
    units    = "kg m-2 yr-1" "mm d-1"
    scaling  = 2.73785e-3 0.0
    time     = 0 0 0 0 1
/

&mar314_1961_1990_pr
    filename = "fesmdata/{domain}/{grid_name}/{grid_name}_SMB-MARv3.14-1961-1990.nc"
    name     = "pr"
    units    = "kg m-2 yr-1" "mm d-1"
    scaling  = 2.73785e-3 0.0
    time     = 0 0 0 0 1
/

&mar314_1961_1990_zs
    filename = "fesmdata/{domain}/{grid_name}/{grid_name}_SMB-MARv3.14-1961-1990.nc"
    name     = "z_srf"
    units    = "m" "m"
    scaling  = 1.0 0.0
    time     = 0 0 0 0 1
/

! ---- RACMO2.3p2, 1981-2010 (Antarctica), monthly ------------------------
! tas: 2 m air temperature; tsrf: surface temperature (T_srf, what the
! snapclim Antarctica configs read from the RACMO2.3 ERA-Interim hybrid).

&racmo23p2_1981_2010_tas
    filename = "fesmdata/{domain}/{grid_name}/{grid_name}_SMB-RACMO2.3p2-1981-2010.nc"
    name     = "t2m"
    units    = "K" "K"
    scaling  = 1.0 0.0
    time     = 0 0 0 0 1
/

&racmo23p2_1981_2010_tsrf
    filename = "fesmdata/{domain}/{grid_name}/{grid_name}_SMB-RACMO2.3p2-1981-2010.nc"
    name     = "T_srf"
    units    = "K" "K"
    scaling  = 1.0 0.0
    time     = 0 0 0 0 1
/

&racmo23p2_1981_2010_pr
    filename = "fesmdata/{domain}/{grid_name}/{grid_name}_SMB-RACMO2.3p2-1981-2010.nc"
    name     = "pr"
    units    = "kg m-2 yr-1" "mm d-1"
    scaling  = 2.73785e-3 0.0
    time     = 0 0 0 0 1
/

&racmo23p2_1981_2010_sf
    filename = "fesmdata/{domain}/{grid_name}/{grid_name}_SMB-RACMO2.3p2-1981-2010.nc"
    name     = "sf"
    units    = "kg m-2 yr-1" "mm d-1"
    scaling  = 2.73785e-3 0.0
    time     = 0 0 0 0 1
/

&racmo23p2_1981_2010_zs
    filename = "fesmdata/{domain}/{grid_name}/{grid_name}_SMB-RACMO2.3p2-1981-2010.nc"
    name     = "z_srf"
    units    = "m" "m"
    scaling  = 1.0 0.0
    time     = 0 0 0 0 1
/

! ---- ERA5, 1981-2010 (any domain: North, Laurentide, Pyrenees, ...), monthly

&era5_1981_2010_tas
    filename = "fesmdata/{domain}/{grid_name}/{grid_name}_Atmosphere-ERA5-1981-2010.nc"
    name     = "t2m"
    units    = "K" "K"
    scaling  = 1.0 0.0
    time     = 0 0 0 0 1
/

&era5_1981_2010_pr
    filename = "fesmdata/{domain}/{grid_name}/{grid_name}_Atmosphere-ERA5-1981-2010.nc"
    name     = "pr"
    units    = "kg m-2 d-1" "mm d-1"
    scaling  = 1.0 0.0
    time     = 0 0 0 0 1
/

&era5_1981_2010_sf
    filename = "fesmdata/{domain}/{grid_name}/{grid_name}_Atmosphere-ERA5-1981-2010.nc"
    name     = "sf"
    units    = "kg m-2 d-1" "mm d-1"
    scaling  = 1.0 0.0
    time     = 0 0 0 0 1
/

&era5_1981_2010_zs
    filename = "fesmdata/{domain}/{grid_name}/{grid_name}_Atmosphere-ERA5-1981-2010.nc"
    name     = "zs"
    units    = "m" "m"
    scaling  = 1.0 0.0
    time     = 0 0 0 0 1
/

! ---- ORAS5, 1981-2010 (any domain), monthly climatology (month, depth) ----

&oras5_1981_2010_to
    filename = "fesmdata/{domain}/{grid_name}/{grid_name}_Ocean-ORAS5-1981-2010.nc"
    name     = "to"
    units    = "degC" "K"
    scaling  = 1.0 273.15
    time     = 0 0 0 0 12
    fill     = "nearest"
/

&oras5_1981_2010_so
    filename = "fesmdata/{domain}/{grid_name}/{grid_name}_Ocean-ORAS5-1981-2010.nc"
    name     = "so"
    units    = "PSU" "PSU"
    scaling  = 1.0 0.0
    time     = 0 0 0 0 12
    fill     = "nearest"
/

! ---- ISMIP7 ocean (Antarctica), annual (depth z) --------------------------

&ismip7_to
    filename = "fesmdata/{domain}/{grid_name}/{grid_name}_Ocean-ISMIP7.nc"
    name     = "to"
    units    = "degC" "K"
    scaling  = 1.0 273.15
    time     = 0 0 0 0 1
    fill     = "nearest"
/

&ismip7_so
    filename = "fesmdata/{domain}/{grid_name}/{grid_name}_Ocean-ISMIP7.nc"
    name     = "so"
    units    = "PSU" "PSU"
    scaling  = 1.0 0.0
    time     = 0 0 0 0 1
    fill     = "nearest"
/

! ===== Paleoclimate: global products ({grid_global}, {exp}) =====

! ---- PMIP3 ensemble mean, {exp} = lgm | midHolocene | piControl ----------
! Annual means and seasons (jja, djf; tas_season of the snapshot).

&pmip3_mean_tas_ann
    filename = "fesmdata/Global/{grid_global}/{grid_global}_Paleoclimate-PMIP3-{exp}-mean.nc"
    name     = "t2m_ann"
    units    = "degC" "K"
    scaling  = 1.0 273.15
    time     = 0 0 0 0 1
    remap    = "bilin"
    grid_src = "{grid_global}"
/

&pmip3_mean_tas_jja
    filename = "fesmdata/Global/{grid_global}/{grid_global}_Paleoclimate-PMIP3-{exp}-mean.nc"
    name     = "t2m_jja"
    units    = "degC" "K"
    scaling  = 1.0 273.15
    time     = 0 0 0 0 1
    remap    = "bilin"
    grid_src = "{grid_global}"
/

&pmip3_mean_tas_djf
    filename = "fesmdata/Global/{grid_global}/{grid_global}_Paleoclimate-PMIP3-{exp}-mean.nc"
    name     = "t2m_djf"
    units    = "degC" "K"
    scaling  = 1.0 273.15
    time     = 0 0 0 0 1
    remap    = "bilin"
    grid_src = "{grid_global}"
/

&pmip3_mean_pr_ann
    filename = "fesmdata/Global/{grid_global}/{grid_global}_Paleoclimate-PMIP3-{exp}-mean.nc"
    name     = "pr_ann"
    units    = "mm d-1" "mm d-1"
    scaling  = 1.0 0.0
    time     = 0 0 0 0 1
    remap    = "bilin"
    grid_src = "{grid_global}"
/

&pmip3_mean_zs
    filename = "fesmdata/Global/{grid_global}/{grid_global}_Paleoclimate-PMIP3-{exp}-mean.nc"
    name     = "z_srf"
    units    = "m" "m"
    scaling  = 1.0 0.0
    time     = 0 0 0 0 1
    remap    = "bilin"
    grid_src = "{grid_global}"
/

