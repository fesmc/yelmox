! ---- CLIMBER-3alpha (Montoya et al., 2008), {exp} = present | lgm_1p7weak
! | lgm_1p7strong. Annual means and JJA only (tas_season = "jja", also in
! the south); the ocean (to, annual) in the -ocean file.

&c3a_tas_ann
    filename = "fesmdata/Global/{grid_global}/{grid_global}_Paleoclimate-CLIMBER3a-{exp}.nc"
    name     = "t2m_ann"
    units    = "degC" "K"
    scaling  = 1.0 273.15
    time     = 0 0 0 0 1
    remap    = "bilin"
    grid_src = "{grid_global}"
/

&c3a_tas_jja
    filename = "fesmdata/Global/{grid_global}/{grid_global}_Paleoclimate-CLIMBER3a-{exp}.nc"
    name     = "t2m_jja"
    units    = "degC" "K"
    scaling  = 1.0 273.15
    time     = 0 0 0 0 1
    remap    = "bilin"
    grid_src = "{grid_global}"
/

&c3a_pr_ann
    filename = "fesmdata/Global/{grid_global}/{grid_global}_Paleoclimate-CLIMBER3a-{exp}.nc"
    name     = "pr_ann"
    units    = "mm d-1" "mm d-1"
    scaling  = 1.0 0.0
    time     = 0 0 0 0 1
    remap    = "bilin"
    grid_src = "{grid_global}"
/

&c3a_zs
    filename = "fesmdata/Global/{grid_global}/{grid_global}_Paleoclimate-CLIMBER3a-{exp}.nc"
    name     = "z_srf"
    units    = "m" "m"
    scaling  = 1.0 0.0
    time     = 0 0 0 0 1
    remap    = "bilin"
    grid_src = "{grid_global}"
/

&c3a_to
    filename = "fesmdata/Global/{grid_global}/{grid_global}_Paleoclimate-CLIMBER3a-{exp}-ocean.nc"
    name     = "to"
    units    = "degC" "K"
    scaling  = 1.0 273.15
    time     = 0 0 0 0 1
    remap    = "bilin"
    grid_src = "{grid_global}"
    fill     = "nearest"
/

! ---- CLIMBER-X (Willeit et al., 2025), {exp} = piControl | interstadial |
! stadial | heinrich. Monthly and annual means; the _anom fields are the
! anomalies to piControl (the hi of a lo = "" axis; pr_mon_anom is a
! difference in mm d-1, not a ratio); the ocean (to, so, annual) in the
! -ocean file.

&cx_tas_mon
    filename = "fesmdata/Global/{grid_global}/{grid_global}_Paleoclimate-CLIMBERX-Willeit2025-{exp}.nc"
    name     = "t2m_mon"
    units    = "degC" "K"
    scaling  = 1.0 273.15
    time     = 0 0 0 0 1
    remap    = "bilin"
    grid_src = "{grid_global}"
/

&cx_pr_mon
    filename = "fesmdata/Global/{grid_global}/{grid_global}_Paleoclimate-CLIMBERX-Willeit2025-{exp}.nc"
    name     = "pr_mon"
    units    = "mm d-1" "mm d-1"
    scaling  = 1.0 0.0
    time     = 0 0 0 0 1
    remap    = "bilin"
    grid_src = "{grid_global}"
/

&cx_tas_ann
    filename = "fesmdata/Global/{grid_global}/{grid_global}_Paleoclimate-CLIMBERX-Willeit2025-{exp}.nc"
    name     = "t2m_ann"
    units    = "degC" "K"
    scaling  = 1.0 273.15
    time     = 0 0 0 0 1
    remap    = "bilin"
    grid_src = "{grid_global}"
/

&cx_pr_ann
    filename = "fesmdata/Global/{grid_global}/{grid_global}_Paleoclimate-CLIMBERX-Willeit2025-{exp}.nc"
    name     = "pr_ann"
    units    = "mm d-1" "mm d-1"
    scaling  = 1.0 0.0
    time     = 0 0 0 0 1
    remap    = "bilin"
    grid_src = "{grid_global}"
/

&cx_zs
    filename = "fesmdata/Global/{grid_global}/{grid_global}_Paleoclimate-CLIMBERX-Willeit2025-{exp}.nc"
