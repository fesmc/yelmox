! =====================================================================
! forcing_db.nml — shared library of named forcing groups: snapshots
! [snapshot_<name>], series [series_<name>], terms [term_<name>] and elsa
! layer settings [elsa_<name>]. The forcing as terms: docs/_forcing-terms.md.
!
! Lookup: a named group is read from the par file if it has it, else from the
! first [forcing] var_defs file that does (this file is in the default list).
! A par file uses the library by selecting groups by name:
!     &forcing  reference = "pd"  series = "alpha" "dTo"  terms = "lgm" "ocean"
! elsa groups are read by yelmo straight from the file [ytrc] elsa_nml names,
! selected by [ytrc] elsa_group:
!     &ytrc     elsa_nml = "input/forcing_db.nml"  elsa_group = "elsa_grl_lgp"
!
! Override: define the group in the par file (it wins over this file), or set
! a key with runme -p (e.g. -p term_lgm.fields=tas): runme copies the whole
! group from this file into the staged par file, then applies the override
! (par_library in .runme/info.json).
!
! The present-day snapshot_pd stays in each par file (domain-specific), as do
! [forcing] (the per-run selection) and [snapshots] (the backend's rules).
! Unset keys: the templates snapshot, series and term of
! input/yelmox_defaults.nml.
! =====================================================================

! ===== Snapshots (var_defs groups of input/clim_db.nml per field; {exp} of the paths) =====
! A field a snapshot does not bind is left out (picontrol, lgm: no ocean).

! ---- PMIP3 piControl and LGM, global ensemble means (summer: JJA) ----------
! Antarctica (summer: DJF): -p snapshot_picontrol.tas==pmip3_mean_tas_ann,pmip3_mean_tas_djf
! and the same for snapshot_lgm (scripts/ant-paleo/params.sh).

&snapshot_picontrol
    exp        = "piControl"
    monthly    = False
    clim_sigma = 50.0             ! [km] smoothing of the PMIP3 fields
    tas = "pmip3_mean_tas_ann" "pmip3_mean_tas_jja"
    pr  = "pmip3_mean_pr_ann"
    zs  = "pmip3_mean_zs"
/

&snapshot_lgm
    exp        = "lgm"
    monthly    = False
    clim_sigma = 50.0             ! [km] smoothing of the PMIP3 fields
    tas = "pmip3_mean_tas_ann" "pmip3_mean_tas_jja"
    pr  = "pmip3_mean_pr_ann"
    zs  = "pmip3_mean_zs"
/

! ---- Greenland reconstructions: Buizert et al. (2018), Badgeley et al. (2020)

&snapshot_b18_base
    tas = "b18_1981_2010_tas"
    pr  = "b18_1981_2010_pr"
    zs  = "b18_1981_2010_zs"
/

&snapshot_b18
    tas = "b18_tas"
    pr  = "b18_pr"
    zs  = "b18_zs"
/

&snapshot_b20
    monthly = False     ! annual: the same anomaly in every month
    tas = "b20_tas_anom" "b20_tas_anom"
    pr  = "b20_pr_frac"  ! or b20_pr_frac_low, b20_pr_frac_high
/

! ===== Series (tsgen groups, or derived; units and restart_every_df optional) =====

&series_alpha
    ! The default alpha, read when the par file has no [series_alpha]: the
    ! glacial index alpha_combined_125kyr_interp (0 at present, ~0.9 at 21 ka),
    ! as is (not normalised). The series are named by their symbol in the
    ! equation (alpha, beta, gamma, ...); a setup sets the record of each in
    ! its par file (yelmox_Greenland.nml: alpha_orbital_r2020, normalised).
    method      = "series"
    series_file = "input/alpha_combined_125kyr_interp.dat"
/

&series_dTo
    ! The ocean temperature anomaly from the atmosphere: 0.25 times the mean
    ! sea-level air temperature anomaly of the climate update over the
    ! climate grid [K] (derived, set by the climate); added to the ocean
    ! profiles by term_ocean.
    method = "derived"
    from   = "air_anomaly"
    factor = 0.25
    region = "all"
    units  = "K"
/

&series_ramp
    ! Functionality test: ramp + noise, a uniform anomaly (term_ramp).
    method     = "ramp-slope"  ! constant-rate ramp (df_dt_max), clamped to [f_min,f_max]
    with_kill  = False      ! stop the run once the response equilibrates at a bound
    dt_init    = 0.0        ! [yr]  hold forcing flat during this initial interval
    dt_ramp    = 300.0      ! [yr]  ramp/period length (ramp-time, ramp-time-step, sin)
    dt_conv    = -1.0       ! [yr]  convergence interval (ramp-time-step)
    dt_ave     = 100.0      ! [yr]  averaging window for the response derivative (feedback)
    df_sign    = 1          ! +1/-1 direction of forcing change
    tol        = 1.0        ! response-rate tolerance (feedback/kill)
    df_dt_max  = 0.0025     ! [f/yr] ramp rate: f 0->5 over 2000 yr -> dTa 0->5 K
    sigma      = 0.3        ! [f]   white-noise std dev on f_now -> ~0.3 K jitter on dTa
    f_min      = 0.0        ! [f]   lower forcing bound
    f_max      = 5.0        ! [f]   upper forcing bound (dTa caps at 5 K)
    f_conv     = 0.0        ! [f]   hold value after convergence (ramp-time-step)
    units      = "K"
/

&series_hyst
    ! Hysteresis: series "hyst" with the uniform term_hyst.
    method     = "PI42"     ! const|ramp-slope|ramp-time|ramp-time-step|sin|exp|PI42|H312b|H312PID|H321PID|PID1
    with_kill  = True       ! stop the run once the response equilibrates at a bound
    dt_init    = 200.0      ! [yr]  hold forcing flat during this initial interval
    dt_ramp    = 300.0      ! [yr]  ramp/period length (ramp-time, ramp-time-step, sin)
    dt_conv    = -1.0       ! [yr]  convergence interval (ramp-time-step)
    dt_ave     = 100.0      ! [yr]  averaging window for the response derivative (feedback)
    df_sign    = 1          ! +1/-1 direction of forcing change
    tol        = 20.0       ! [Gt/yr] target/tolerance response rate (feedback/kill; was hyster.eps)
    df_dt_max  = 1e-4       ! [f/yr] maximum forcing rate (4/1e-4 ~ 60 kyr)
    sigma      = 0.0        ! [f]   std. dev. of optional gaussian noise
    f_min      = 0.0        ! [f]   lower forcing bound
    f_max      = 4.0        ! [f]   upper forcing bound
    f_conv     = 0.0        ! [f]   hold value after convergence (ramp-time-step)
    units      = "K"
/

&series_dT
    ! Sensitivity anomaly for run_mg_forward.sh (series "dT", term_dT): a
    ! constant [K], set there with f_min = f_max.
    method = "const"
    f_min  = 0.0
    f_max  = 0.0
    units  = "K"
/

&series_obm_north
    ! yelmox_bipolar: the northern box temperature of the ocean box model [K]
    ! (derived, set by the bridge after the box model), the ocean of the
    ! northern domain with term_obm_north.
    method  = "derived"
    from    = "obm_north"
    anomaly = False     ! the temperature itself (True: minus its initial value)
    units   = "K"
/

&series_obm_south
    ! yelmox_bipolar: the southern box temperature [K] (term_obm_south).
    method  = "derived"
    from    = "obm_south"
    anomaly = False
    units   = "K"
/

! ===== Terms (series x pattern on explicit fields) =====

&term_lgm
    ! The LGM anomaly (PMIP3 lgm - piControl) weighted by alpha:
    ! tas + alpha*(lgm - picontrol), pr * (1 + alpha*(lgm/picontrol - 1)).
    series = "alpha"
    snap0  = "picontrol"
    snap1  = "lgm"
    fields = "tas" "pr"
/

&term_b18
    ! The Buizert et al. (2018) temperature reconstruction in time, as its
    ! anomaly to its own 1981-2010 baseline, in full (no series).
    snap0  = "b18_base"
    snap1  = "b18"
    fields = "tas"
/

&term_b20
    ! The Badgeley et al. (2020) precipitation ratio in time, in full.
    snap0  = ""
    snap1  = "b20"
    fields = "pr"
/

&term_ocean
    ! The ocean temperature profiles plus the derived anomaly series_dTo
    ! (0.25 x the mean sea-level air temperature anomaly).
    series  = "dTo"
    pattern = "uniform"
    fields  = "to"
/

&term_ramp
    ! A uniform anomaly from series_ramp: tas + f, pr * exp(beta_p*f).
    series  = "ramp"
    pattern = "uniform"
    fields  = "tas" "pr"
/

&term_hyst
    ! A uniform anomaly from the hysteresis series.
    series  = "hyst"
    pattern = "uniform"
    fields  = "tas" "pr"
/

&term_dT
    ! A uniform anomaly of series_dT [K].
    series  = "dT"
    pattern = "uniform"
    fields  = "tas" "pr"
/

&term_obm_north
    ! yelmox_bipolar: the ocean temperature profiles replaced by the northern
    ! box temperature at every depth (series_obm_north); with anomaly = True
    ! in the series and pattern = "uniform" here, the reference plus the box
    ! anomaly instead.
    series  = "obm_north"
    pattern = "replace"
    fields  = "to"
/

&term_obm_south
    ! yelmox_bipolar: the ocean of the southern domain from the southern box.
    series  = "obm_south"
    pattern = "replace"
    fields  = "to"
/

! ===== elsa (Lagrangian isochrone layers; read by yelmo, see the header) =====

&elsa_grl_lgp
    n_layers_init    = 10          ! [1]  initialization layers
    layer_resolution = 1000.0      ! [yr] add an isochrone this often
    layer_file       = "None"      ! [-]  or an explicit list of isochrone times
    grid_factor      = 1.0         ! [1]  elsa on the Yelmo grid (required for t_dep_elsa)
    dt_coupling      = 50.0        ! [yr] elsa update interval
    cfl              = 0.9         ! [1]  advection sub-step target
    allow_pos_bmb    = False       ! [-]  let freeze-on thicken the bottom layer
/

&elsa_grl_deglac
    n_layers_init    = 10          ! [1]  initialization layers
    layer_resolution = 500.0       ! [yr] add an isochrone this often
    layer_file       = "None"      ! [-]  or an explicit list of isochrone times
    grid_factor      = 1.0         ! [1]  elsa on the Yelmo grid (required for t_dep_elsa)
    dt_coupling      = 50.0        ! [yr] elsa update interval
    cfl              = 0.9         ! [1]  advection sub-step target
    allow_pos_bmb    = False       ! [-]  let freeze-on thicken the bottom layer
/

&elsa_ant_paleo
    n_layers_init    = 10          ! [1]  initialization layers
    layer_resolution = 1000.0      ! [yr] add an isochrone this often
    layer_file       = "None"      ! [-]  or an explicit list of isochrone times
    grid_factor      = 1.0         ! [1]  elsa on the Yelmo grid (required for t_dep_elsa)
    dt_coupling      = 50.0        ! [yr] elsa update interval
    cfl              = 0.9         ! [1]  advection sub-step target
    allow_pos_bmb    = False       ! [-]  let freeze-on thicken the bottom layer
/
