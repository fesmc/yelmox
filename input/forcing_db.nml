! =====================================================================
! forcing_db.nml — shared library of named forcing groups: snapshots
! [snap_<name>], snapshot axes [snap_axis_<name>], indices [idx_<name>] and
! elsa layer settings [elsa_<name>].
!
! Lookup: a named group is read from the par file if it has it, else from the
! first var_defs file that does. A par file uses this library by listing it
! and selecting groups by name ([snap] snapshots and axes, [indices] names):
!     &snap     var_defs = "input/clim_db.nml" "input/forcing_db.nml"
!     &indices  var_defs = "input/forcing_db.nml"
! elsa groups are read by yelmo straight from the file [ytrc] elsa_nml names,
! selected by [ytrc] elsa_group:
!     &ytrc     elsa_nml = "input/forcing_db.nml"  elsa_group = "elsa_grl_lgp"
!
! Override: define the group in the par file (it wins over this file), or set
! a key with runme -p (e.g. -p idx_a.f_min=0): runme copies the whole group
! from this file into the staged par file, then applies the override
! (par_library in .runme/info.json).
!
! snap_pd and [snap_field_*] stay in the par files (domain-specific), as do
! [snap] and [indices] (the per-run selection). Unset keys: the templates
! snap_snapshot, snap_axis and idx of input/yelmox_defaults.nml.
! =====================================================================

! ===== Snapshots (var_defs groups of input/clim_db.nml per field; {exp} of the paths) =====
! A field a snapshot does not bind is left out (picontrol, lgm: no ocean).

! ---- PMIP3 piControl and LGM, global ensemble means (summer: JJA) ----------

&snap_picontrol
    exp        = "piControl"
    monthly    = False
    clim_sigma = 50.0             ! [km] smoothing of the PMIP3 fields
    tas = "pmip3_mean_tas_ann" "pmip3_mean_tas_jja"
    pr  = "pmip3_mean_pr_ann"
    zs  = "pmip3_mean_zs"
/

&snap_lgm
    exp        = "lgm"
    monthly    = False
    clim_sigma = 50.0             ! [km] smoothing of the PMIP3 fields
    tas = "pmip3_mean_tas_ann" "pmip3_mean_tas_jja"
    pr  = "pmip3_mean_pr_ann"
    zs  = "pmip3_mean_zs"
/

! ---- PMIP3 piControl and LGM, Antarctica (summer: DJF) ---------------------

&snap_picontrol_ant
    exp        = "piControl"
    monthly    = False
    clim_sigma = 50.0             ! [km] smoothing of the PMIP3 fields
    tas = "pmip3_mean_tas_ann" "pmip3_mean_tas_djf"
    pr  = "pmip3_mean_pr_ann"
    zs  = "pmip3_mean_zs"
/

&snap_lgm_ant
    exp        = "lgm"
    monthly    = False
    clim_sigma = 50.0             ! [km] smoothing of the PMIP3 fields
    tas = "pmip3_mean_tas_ann" "pmip3_mean_tas_djf"
    pr  = "pmip3_mean_pr_ann"
    zs  = "pmip3_mean_zs"
/

! ---- Greenland reconstructions: Buizert et al. (2018), Badgeley et al. (2020)

&snap_b18_base
    tas = "b18_1981_2010_tas"
    pr  = "b18_1981_2010_pr"
    zs  = "b18_1981_2010_zs"
/

&snap_b18
    tas = "b18_tas"
    pr  = "b18_pr"
    zs  = "b18_zs"
/

&snap_b20
    monthly = False     ! annual: the same anomaly in every month
    tas = "b20_tas_anom" "b20_tas_anom"
    pr  = "b20_pr_frac"  ! or b20_pr_frac_low, b20_pr_frac_high
/

! ===== Axes (two snapshots and the index giving the position on them) =====
! The value of the index is the position on the axis lo -> hi (0 -> 1).

&snap_axis_a
    lo    = "picontrol"
    hi    = "lgm"
    index = "a"
/

&snap_axis_at
    lo    = "picontrol"
    hi    = "lgm"
    index = "at"
/

&snap_axis_a_ant
    lo    = "picontrol_ant"
    hi    = "lgm_ant"
    index = "a"
/

&snap_axis_b18
    lo    = "b18_base"
    hi    = "b18"
    index = "one"
/

&snap_axis_b20
    lo    = ""
    hi    = "b20"
    index = "one"
/

! ===== Indices (tsgen groups; units and restart_every_df optional) =====

&idx_a
    ! Glacial index (alpha_combined_125kyr_interp: 0 at present, ~0.9 at
    ! 21 ka), the position on the snapshots axis "a", used as is (not
    ! normalised).
    method      = "series"
    series_file = "input/alpha_combined_125kyr_interp.dat"
/

&idx_a_lgm
    ! Glacial index, constant 1 (LGM): the position on the snapshots axis "a".
    method = "const"
    f_min  = 1.0
/

&idx_at
    ! Glacial index: the orbital series normalised to 0 at present (piControl)
    ! and 1 at 21 ka (LGM); the position on the snapshots axis "at".
    method      = "series"
    series_file = "input/alpha_orbital_r2020.dat"
    norm_t0     = 0.0
    norm_t1     = -21e3
/

&idx_one
    ! Constant 1: the full anomaly of the reconstructions (axes b18, b20).
    method = "const"
    f_min  = 1.0
    f_max  = 1.0
/

&idx_ramp
    ! Functionality test: ramp + noise, the [anom] anomaly.
    method     = "ramp-slope"  ! constant-rate ramp (df_dt_max), clamped to [f_min,f_max]
    with_kill  = False      ! stop the run once the response equilibrates at a bound
    dt_init    = 0.0        ! [yr]  hold forcing flat during this initial interval
    dt_ramp    = 300.0      ! [yr]  ramp/period length (ramp-time, ramp-time-step, sin)
    dt_conv    = -1.0       ! [yr]  convergence interval (ramp-time-step)
    dt_ave     = 100.0      ! [yr]  averaging window for the response derivative (feedback)
    df_sign    = 1          ! +1/-1 direction of forcing change
    tol        = 1.0        ! response-rate tolerance (feedback/kill)
    df_dt_max  = 0.0025     ! [f/yr] ramp rate: f 0->5 over 2000 yr -> dTa 0->5 K
    sigma      = 0.3        ! [f]   white-noise std dev on f_now -> ~0.3 K jitter on dTa
    f_min      = 0.0        ! [f]   lower forcing bound
    f_max      = 5.0        ! [f]   upper forcing bound (dTa caps at 5 K)
    f_conv     = 0.0        ! [f]   hold value after convergence (ramp-time-step)
/

&idx_orb
    ! Orbital index: alpha_orbital_t2018 (1 at present, 0 at 21 ka) normalised
    ! to 0 at present and 1 at 21 ka; scaled by [anom] f_ta.
    method      = "series"
    series_file = "input/alpha_orbital_t2018.dat"
    norm_t0     = 0.0
    norm_t1     = -21e3
/

&idx_hyst
    ! Hysteresis: add "hyst" to [indices] names and set [anom] active = True,
    ! index = "hyst".
    method     = "PI42"     ! const|ramp-slope|ramp-time|ramp-time-step|sin|exp|PI42|H312b|H312PID|H321PID|PID1
    with_kill  = True       ! stop the run once the response equilibrates at a bound
    dt_init    = 200.0      ! [yr]  hold forcing flat during this initial interval
    dt_ramp    = 300.0      ! [yr]  ramp/period length (ramp-time, ramp-time-step, sin)
    dt_conv    = -1.0       ! [yr]  convergence interval (ramp-time-step)
    dt_ave     = 100.0      ! [yr]  averaging window for the response derivative (feedback)
    df_sign    = 1          ! +1/-1 direction of forcing change
    tol        = 20.0       ! [Gt/yr] target/tolerance response rate (feedback/kill; was hyster.eps)
    df_dt_max  = 1e-4       ! [f/yr] maximum forcing rate (4/1e-4 ~ 60 kyr)
    sigma      = 0.0        ! [f]   std. dev. of optional gaussian noise
    f_min      = 0.0        ! [f]   lower forcing bound
    f_max      = 4.0        ! [f]   upper forcing bound
    f_conv     = 0.0        ! [f]   hold value after convergence (ramp-time-step)
/

&idx_dT
    ! Sensitivity anomaly for run_mg_forward.sh (with [indices] names = "dT",
    ! [anom] index = "dT"): a constant [K], set there with f_min = f_max.
    method = "const"
    f_min  = 0.0
    f_max  = 0.0
/

! ===== elsa (Lagrangian isochrone layers; read by yelmo, see the header) =====

&elsa_grl_lgp
    n_layers_init    = 10          ! [1]  initialization layers
    layer_resolution = 1000.0      ! [yr] add an isochrone this often
    layer_file       = "None"      ! [-]  or an explicit list of isochrone times
    grid_factor      = 1.0         ! [1]  elsa on the Yelmo grid (required for t_dep_elsa)
    dt_coupling      = 50.0        ! [yr] elsa update interval
    cfl              = 0.9         ! [1]  advection sub-step target
    allow_pos_bmb    = False       ! [-]  let freeze-on thicken the bottom layer
/

&elsa_grl_deglac
    n_layers_init    = 10          ! [1]  initialization layers
    layer_resolution = 500.0       ! [yr] add an isochrone this often
    layer_file       = "None"      ! [-]  or an explicit list of isochrone times
    grid_factor      = 1.0         ! [1]  elsa on the Yelmo grid (required for t_dep_elsa)
    dt_coupling      = 50.0        ! [yr] elsa update interval
    cfl              = 0.9         ! [1]  advection sub-step target
    allow_pos_bmb    = False       ! [-]  let freeze-on thicken the bottom layer
/

&elsa_ant_paleo
    n_layers_init    = 10          ! [1]  initialization layers
    layer_resolution = 1000.0      ! [yr] add an isochrone this often
    layer_file       = "None"      ! [-]  or an explicit list of isochrone times
    grid_factor      = 1.0         ! [1]  elsa on the Yelmo grid (required for t_dep_elsa)
    dt_coupling      = 50.0        ! [yr] elsa update interval
    cfl              = 0.9         ! [1]  advection sub-step target
    allow_pos_bmb    = False       ! [-]  let freeze-on thicken the bottom layer
/
